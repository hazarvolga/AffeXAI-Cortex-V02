# ==============================================
# AFFEXAI PRODUCTION ENVIRONMENT VARIABLES
# ==============================================
# This template shows all required environment variables for production deployment
# Copy values to Coolify environment variables section

# ==============================================
# APPLICATION
# ==============================================
NODE_ENV=production
PORT=9006
APP_URL=https://api.your-affexai-domain.example

# ==============================================
# DATABASE (PostgreSQL)
# ==============================================
# The production Compose stack wires these values to internal PostgreSQL.
DATABASE_USERNAME=affexai
DATABASE_PASSWORD=PASSWORD_HERE
DATABASE_NAME=affexai

# ==============================================
# REDIS CACHE
# ==============================================
REDIS_PASSWORD=PASSWORD_HERE

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_SECRET
BACKUP_ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_SECRET
CORTEX_SERVICE_SECRET=CHANGE_THIS_TO_RANDOM_SECRET
# Comma-separated user UUID allowlist; leave empty until the platform admin user exists.
PLATFORM_ADMIN_USER_IDS=
QDRANT_API_KEY=CHANGE_THIS_TO_RANDOM_SECRET

# ==============================================
# AI PROVIDERS
# ==============================================
# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini)
GOOGLE_AI_API_KEY=AIzaSy...

# ==============================================
# EMAIL SERVICE (Resend)
# ==============================================
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@affexai.com
EMAIL_FROM_NAME=Affexai Platform

# ==============================================
# AWS S3 STORAGE
# ==============================================
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
AWS_S3_BUCKET=affexai-uploads
AWS_REGION=us-east-1

# ==============================================
# BACKEND REWRITE TARGET (frontend next.config.ts)
# ==============================================
BACKEND_URL=http://backend:9006

# Public values are embedded into the frontend image at build time.
NEXT_PUBLIC_API_URL=https://api.your-affexai-domain.example/api
NEXT_PUBLIC_SOCKET_URL=https://api.your-affexai-domain.example
NEXT_PUBLIC_APP_URL=https://your-affexai-domain.example

# ==============================================
# SQL QUERY LOGGING (backend app.module.ts)
# Keep false in production; set true only for debugging
# ==============================================
DB_LOGGING=false

# ==============================================
# CORS
# ==============================================
CORS_ORIGINS=https://your-affexai-domain.example

# ==============================================
# FRONTEND URL
# ==============================================
FRONTEND_URL=https://your-affexai-domain.example

# ==============================================
# OPTIONAL: AI CONFIGURATION
# ==============================================
# These will be used by the migration to set default AI settings
# If not provided, defaults to Google Gemini with placeholder API key
# AI_PROVIDER=google
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=AIzaSy...

# ==============================================
# DEPLOYMENT NOTES
# ==============================================
# 1. Replace all PASSWORD_HERE and SECRET values
# 2. Generate secure random strings for JWT secrets:
#    openssl rand -base64 32
# 3. Keep database, Redis, JWT, encryption, backup, and Cortex secrets independent
# 4. Create the initial platform administrator through the secure bootstrap flow.
#    Do not place bootstrap credentials in this file or repository.
